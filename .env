# Turso / libSQL 连接配置
# 本地开发（默认）：直接读取项目根目录下的文件库 file:./data/local.db，无需任何额外配置。
TURSO_DATABASE_URL=file:./data/local.db

# 兼容 Turso 云库（可选，无需改代码）：
# 部署时（如 Vercel）在环境变量中设置以下两项即自动切换为远程库，覆盖上面的 file: 值。
# 注：.env 已被 .gitignore 忽略，Vercel 不会读取本文件，生产环境务必在控制台设置：
#   TURSO_DATABASE_URL = libsql://你的库名.turso.io
#   TURSO_AUTH_TOKEN   = 你的令牌（turso db tokens create 生成）
# TURSO_AUTH_TOKEN=your-auth-token

# 站点基础 URL（用于 SEO canonical / OpenGraph）
NEXT_PUBLIC_SITE_URL=http://app.lyc.la

# 站点统计（百度统计 / Google Analytics）
# 仅在填写真实 ID 时启用；留空或注释掉则不注入统计脚本
NEXT_PUBLIC_BAIDU_TONGJI_ID=你的百度统计ID      # 例如 1234567890abc
NEXT_PUBLIC_GA_ID=你的GA4衡量ID                 # 例如 G-XXXXXXXXXX
